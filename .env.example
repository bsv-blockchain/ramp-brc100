# Onramp Money application ID, from https://onramp.money merchant dashboard.
# A number, not a string. Public — it is inlined into the browser bundle.
VITE_ONRAMP_APP_ID=

# Set to "true" to run the widget against Onramp Money's sandbox.
VITE_ONRAMP_SANDBOX=

# No server-side secret is required. The widget takes only the appId — there
# is no URL signing, so there is no signing service and nothing to keep out
# of the bundle.
