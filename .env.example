# ── Public, inlined into the browser bundle ──────────────────────────────
# Onramper API key. https://dashboard.onramper.com/developer
# A `pk_test_` key targets the sandbox widget (buy.onramper.dev);
# `pk_prod_` targets production (buy.onramper.com). The app picks the host
# from the prefix.
VITE_ONRAMPER_API_KEY=

# Endpoint that signs the widget's `wallets` parameter. Served by the Vite dev
# server in development and proxied by nginx to the onramper-sign container in
# production. Leave blank to disable signing — the address is still pre-filled,
# but Onramper rejects it at checkout.
VITE_ONRAMPER_SIGN_URL=/api/onramper/sign

# ── Server-side only — NEVER prefix these with VITE_ ─────────────────────
# Anything named VITE_* is inlined into the public JavaScript bundle. These are
# read by the dev server middleware and the signing container, and are never
# sent to the browser.

# Onramper "Signing Secret". https://docs.onramper.com/docs/signing-widget-url
SIGNING_SECRET=

# Onramper "Webhook Secret". Not used by this app — delivery is detected
# on-chain rather than through Onramper's transaction API. Kept here so the
# file mirrors the dashboard; needed only if you add a webhook receiver.
WEBHOOK_SECRET=

# Comma-separated origins allowed to call the signing endpoint cross-origin.
# Leave blank for same-origin deployments, which is what nginx and the Vite dev
# server both are.
ALLOWED_ORIGINS=
